{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "ProofSight Design Tokens",
  "version": "1.0.0",
  "global": {
    "color": {
      "neutral": {
        "0": "#000000",
        "50": "#0a0d14",
        "100": "#101622",
        "200": "#182133",
        "300": "#222f46",
        "400": "#334566",
        "500": "#4d648d",
        "600": "#7087ad",
        "700": "#9bb0cf",
        "800": "#cdd9ea",
        "900": "#f0f4fa",
        "1000": "#ffffff"
      },
      "brand": {
        "cyan": "#00e5ff",
        "cyanDark": "#00a3b8",
        "cyanGlow": "rgba(0, 229, 255, 0.25)",
        "blue": "#2979ff",
        "indigo": "#3d5afe"
      },
      "status": {
        "success": "#00e676",
        "successBg": "rgba(0, 230, 118, 0.12)",
        "successBorder": "rgba(0, 230, 118, 0.35)",
        "warning": "#ffab00",
        "warningBg": "rgba(255, 171, 0, 0.12)",
        "warningBorder": "rgba(255, 171, 0, 0.35)",
        "error": "#ff1744",
        "errorBg": "rgba(255, 23, 68, 0.12)",
        "errorBorder": "rgba(255, 23, 68, 0.35)",
        "info": "#00b0ff",
        "infoBg": "rgba(0, 176, 255, 0.12)",
        "infoBorder": "rgba(0, 176, 255, 0.35)"
      }
    },
    "fontFamily": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "spacing": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem"
    },
    "borderRadius": {
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "full": "9999px"
    },
    "boxShadow": {
      "glass": "0 8px 32px 0 rgba(0, 0, 0, 0.37)",
      "cyanGlow": "0 0 20px rgba(0, 229, 255, 0.4)",
      "card": "0 4px 20px rgba(0, 0, 0, 0.25)"
    }
  },
  "semantic": {
    "background": {
      "app": "{global.color.neutral.50}",
      "surface": "{global.color.neutral.100}",
      "surfaceSubtle": "{global.color.neutral.200}",
      "glass": "rgba(16, 22, 34, 0.75)",
      "overlay": "rgba(10, 13, 20, 0.85)"
    },
    "text": {
      "primary": "{global.color.neutral.1000}",
      "secondary": "{global.color.neutral.700}",
      "muted": "{global.color.neutral.500}",
      "accent": "{global.color.brand.cyan}"
    },
    "border": {
      "subtle": "{global.color.neutral.200}",
      "default": "{global.color.neutral.300}",
      "focus": "{global.color.brand.cyan}"
    }
  },
  "component": {
    "cameraViewport": {
      "reticleBorder": "{global.color.brand.cyan}",
      "reticleGlow": "{global.color.brand.cyanGlow}",
      "overlayBg": "rgba(0, 0, 0, 0.4)"
    },
    "badge": {
      "verified": {
        "text": "{global.color.status.success}",
        "bg": "{global.color.status.successBg}",
        "border": "{global.color.status.successBorder}"
      },
      "unresolved": {
        "text": "{global.color.status.warning}",
        "bg": "{global.color.status.warningBg}",
        "border": "{global.color.status.warningBorder}"
      },
      "suspectedMissing": {
        "text": "{global.color.status.error}",
        "bg": "{global.color.status.errorBg}",
        "border": "{global.color.status.errorBorder}"
      }
    }
  }
}
